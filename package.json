{
  "name": "lakshmi-hospital-appointments",
  "version": "1.0.0",
  "private": true,
  "description": "Lakshmi Multispecialty Hospital – AI doctor appointment system (website + OmniDimension voice front desk + WhatsApp notifications)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:setup": "node src/db/setup.js",
    "reminders": "node src/jobs/run-reminders.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "test:mysql": "node scripts/test-mysql.js",
    "db:check": "node scripts/db-check.js"
  },
  "dependencies": {
    "dotenv": "^18.0.6",
    "express": "^4.22.3",
    "mysql2": "^3.24.5"
  }
}
