# ------------------------------------------------------------------
# Lakshmi Multispecialty Hospital – environment configuration
# Copy to .env and fill in. NEVER commit .env. These values are read
# only by the server; none of them are sent to the browser or the app.
# ------------------------------------------------------------------

NODE_ENV=development
PORT=3000
# Public URL of the site (used in docs/config; e.g. https://lakshmi-hospital.vercel.app)
PUBLIC_BASE_URL=
# Set true behind a reverse proxy (nginx). Vercel is detected automatically.
TRUST_PROXY=false

# ---------------- Database ----------------
# mysql  = production (XAMPP MySQL/MariaDB locally, or a cloud MySQL for Vercel)
# sqlite = zero-setup local testing only (not for Vercel)
DB_CLIENT=mysql
# Optional single URL, e.g. mysql://root:password@127.0.0.1:3306/lakshmi_hospital
# If set, it overrides the DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD values below.
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lakshmi_hospital
DB_USER=root
DB_PASSWORD=
# Database used by `npm run test:mysql` (wiped on every test run – never the real one)
TEST_DB_NAME=lakshmi_hospital_test
# Cloud MySQL (Aiven, TiDB Cloud, Railway, etc.) usually needs SSL:
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
# Optional CA certificate (PEM; newlines may be written as \n)
DB_SSL_CA=
# Only used when DB_CLIENT=sqlite
SQLITE_FILE=./data/lakshmi.sqlite

# ---------------- Booking rules ----------------
SLOT_MINUTES=15
# Same-day bookings must start at least this many minutes from now
BOOKING_LEAD_MINUTES=30
BOOKING_WINDOW_DAYS=30

# ---------------- Hospital details (public) ----------------
HOSPITAL_ADDRESS=Viruthunagar, Tamil Nadu
HOSPITAL_EMAIL=
HOSPITAL_MAPS_URL=

# ---------------- Private phone numbers ----------------
# AI voice receptionist (OmniDimension) – used only in the /call redirect,
# never printed on any page.
AI_RECEPTIONIST_NUMBER=
# Public WhatsApp chat number for the WHATSAPP button (/whatsapp redirect).
# Leave empty to keep the button showing a "not available" notice.
WHATSAPP_CHAT_NUMBER=

# ---------------- WhatsApp Cloud API (Meta) ----------------
# Staff notification destination (private)
WHATSAPP_NUMBER=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional approved template with ONE body variable {{1}} – needed to message
# numbers outside the 24-hour customer-service window.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=en
# Also send booking/confirmation/cancellation/leave messages to patients
WHATSAPP_NOTIFY_PATIENTS=false
# true = log messages without calling the API (testing)
WHATSAPP_DRY_RUN=false

# ---------------- OmniDimension ----------------
# Shared secret OmniDimension sends in header  X-Webhook-Secret: <value>
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OMNIDIM_WEBHOOK_SECRET=
# Separate secret for the post-call webhook URL (?key=...) – it may not support headers
OMNIDIM_POSTCALL_SECRET=
# Extra browser origins (comma-separated) allowed to call /api/voice/* – e.g. if the
# OmniDimension dashboard is not on omnidim.io. https://*.omnidim.io is always allowed.
OMNIDIM_ALLOWED_ORIGINS=
# Only if your OmniDimension action cannot send headers (?key=...). Avoid.
OMNIDIM_ALLOW_QUERY_SECRET=false
# Your OmniDimension account values (kept for reference/tools; the backend
# does not call the OmniDimension API)
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=

# ---------------- Admin dashboard ----------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 32+ random characters; also signs AI-chat state. Same generator as above.
SESSION_SECRET=
ADMIN_SESSION_HOURS=12

# ---------------- Reminders ----------------
REMINDERS_ENABLED=true
REMINDER_HOURS_BEFORE=24
REMINDER_INTERVAL_MINUTES=10
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/reminders
CRON_SECRET=
